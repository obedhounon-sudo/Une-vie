{
  "name": "recus-scolaires-bureau",
  "productName": "Reçus Scolaires",
  "version": "1.0.0",
  "description": "Reçus Scolaires pour Windows : paiements de scolarité, reçus avec QR code",
  "author": "Obed Hounon (obedklein)",
  "main": "main.js",
  "scripts": { "start": "electron ." },
  "build": {
    "appId": "com.recusscolaires.bureau",
    "productName": "Reçus Scolaires",
    "files": ["main.js", "index.html"],
    "directories": { "output": "dist" },
    "win": {
      "target": [ { "target": "nsis", "arch": ["x64"] }, { "target": "portable", "arch": ["x64"] } ],
      "icon": "build/icon.png"
    },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true, "createDesktopShortcut": true },
    "artifactName": "Recus-Scolaires-${version}-${target}.${ext}"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0"
  }
}
